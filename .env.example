# ===== DRILL Recorder: variables de entorno =====
# Todo es OPCIONAL: sin ninguna, DRILL Recorder funciona en localhost (videos guardados en .data/).
# Copia este archivo a .env.local (npm run dev lo hace solo) y completa lo que quieras activar.
# NUNCA subas .env.local a git ni lo pegues en chats.

# --- IA: transcripción, título, resumen y capítulos (Groq, gratis: console.groq.com → API Keys) ---
GROQ_API_KEY=

# --- Contraseña del dueño (protege biblioteca, grabar, renombrar y borrar). ---
# Vacía = sin contraseña (ok en localhost). Si despliegas en internet, ponla SIEMPRE.
RECORDER_PASSWORD=

# --- Producción: Supabase (supabase.com → Project Settings → API) ---
# Con estas dos, DRILL Recorder guarda en Postgres + Storage en vez de la carpeta .data/. Ver supabase/schema.sql.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Personalización (opcional) ---
# Nombre que se muestra en la barra lateral y como autor de tus videos.
NEXT_PUBLIC_RECORDER_OWNER_NAME=
# URL pública para las previews de los links (por defecto http://localhost:3030).
NEXT_PUBLIC_SITE_URL=

# Solo para instalaciones existentes con un namespace de almacenamiento anterior.
RECORDER_INSTALLATION_NAMESPACE=
